[
  {
    "id": "corpse_in_the_road1",
    "text": [
      "As you travel the lonely road, you come upon a corpse lying in the dirt.",
      "A sword still rests in its lifeless grasp, and blood stains both the body and the earth around it."
    ],
    "choices": [
      {
        "text": "Steal the sword",
        "outcome": {
          "successStatChanges": { "sanity": -10, "exp": 10, "morality": -15 },
          "successAddItems": ["iron_sword"]
        }
      },
      {
        "text": "Bury the corpse",
        "conditions": [{ "type": "HAS_ITEM", "key": "simple_spade" }],
        "outcome": {
          "successStatChanges": { "exp": 10, "morality": 10 }
        }
      },
      {
        "text": "Search the body",
        "conditions": [{ "type": "STAT_MIN", "key": "intelligence", "value": 8 }],
        "outcome": {
          "successChance": 30,
          "skillCheck": { "stat": "intelligence", "bonusPerPoint": 5 },
          "nextEventId": "corpse_in_the_road_note",
          "failEventId": "corpse_in_the_road_empty",
          "successStatChanges": { "exp": 10, "morality": -10 },
          "failStatChanges": { "exp": 1, "morality": -10 }
        }
      },
      {
        "text": "Pass the body",
        "outcome": {
          "successStatChanges": { "exp": 1 }
        }
      }
    ]
  },
  {
